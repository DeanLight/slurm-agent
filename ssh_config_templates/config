# Copy to ~/.ssh/config (or append), replacing deanlcs with your own UW CS id.
# ControlMaster is what makes UW 2FA a once-a-day event: the first connection
# authenticates, every later one reuses the socket.
Host tillicum-login
    Hostname klone.hyak.uw.edu
    User deanlcs
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 8h
    ServerAliveInterval 60

Include tillicum-node-config
