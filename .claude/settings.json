{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "enableAllProjectMcpServers": true,

  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(poe:*)",
      "Bash(uv run poe:*)",
      "Bash(slurm-agent:*)",
      "Bash(uv run slurm-agent:*)",
      "Bash(uv run pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ssh tillicum-login:*)",
      "Read(//**)",
      "mcp__notion",
      "mcp__github"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.envrc)",
      "Read(./**/.envrc)"
    ]
  }
}
