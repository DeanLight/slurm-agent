# Artifact notebooks are committed WITH their outputs — un-ignore each one you
# declare in [tool.juplit] artifact_notebooks, e.g.:
# !experiments/ablation.ipynb
slurm_agent/**/*.ipynb
slurm_agent/*.ipynb
docs/*.ipynb
# The quick start is an artifact notebook: run it on a new machine and commit what it
# printed, because those outputs are the proof the clone works.
!docs/quickstart.ipynb
.ipynb_checkpoints/
.juplit/
# juplit's pairing state — per-checkout, rebuilt by `poe sync`.
.sync_hashes.json
__pycache__/
*.egg-info/
.venv/
dist/
.env

# The real secrets. templates/envrc.example is the committed placeholder version.
.envrc

# Session notebooks are NOT committed here. A session's record belongs in the repo the
# agents worked on, alongside the experiment it is about — this repo is the control plane
# and commits no notebooks of its own.
sessions/

# The usage ledger is per-machine.
ledger.jsonl

# A run root should live on the cluster, never inside a checkout — but if one ever does,
# it must not become a commit.
.slurm-agent/
