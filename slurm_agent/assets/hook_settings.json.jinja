{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": {"tools": ["Bash", "Edit", "Write", "NotebookEdit"]},
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ run_dir }}/remote_status.py remind --log-dir {{ log_dir }}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ run_dir }}/remote_status.py tick --log-dir {{ log_dir }}"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ run_dir }}/remote_status.py finish --log-dir {{ log_dir }} && python3 {{ run_dir }}/remote_notify.py --from-status"
          }
        ]
      }
    ]
  }
}
