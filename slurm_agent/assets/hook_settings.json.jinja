{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ run_dir }}/remote_status.py tick --notebook {{ notebook }}"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{ run_dir }}/remote_status.py finish --notebook {{ notebook }} && python3 {{ run_dir }}/remote_notify.py --from-status"
          }
        ]
      }
    ]
  }
}
